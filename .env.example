# Copy to .env.local and fill in values from `npx supabase status`.
# Only publishable values belong here: anything prefixed NEXT_PUBLIC_ is
# bundled into client JavaScript. Never put the secret (service role) key
# behind a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
