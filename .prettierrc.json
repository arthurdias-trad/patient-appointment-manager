{
  "plugins": ["prettier-plugin-sql-cst"],
  "overrides": [
    {
      "files": "**/*.sql",
      "options": {
        "parser": "postgresql",
        "tabWidth": 2,
        "printWidth": 100,
        "sqlKeywordCase": "lower",
        "sqlLiteralCase": "lower",
        "sqlTypeCase": "lower"
      }
    }
  ]
}
